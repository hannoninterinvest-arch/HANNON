# Variables à coller dans Vercel → Settings → Environment Variables
# (Production et Preview), puis Redeploy.
#
# PostgreSQL reste obligatoire. Neon (ou un autre Postgres) fournit DATABASE_URL.
# Préférez l'hôte Neon avec "-pooler" pour Vercel.
# Ne définissez pas NEXT_PUBLIC_API_URL : le site appelle /api sur le même domaine.

DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/neondb?sslmode=require
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
ADMIN_EMAIL=admin@hannoninterinvest.com
ADMIN_PASSWORD=change-me
