# Local (Next.js -> Nest on your machine)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Vercel (front) -> Render (back)
# Set this in Vercel → Settings → Environment Variables (Production + Preview)
# then Redeploy. Replace with your real Render URL:
# NEXT_PUBLIC_API_URL=https://YOUR-SERVICE.onrender.com/api
