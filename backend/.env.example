# L'application déployée sur Vercel est le Next.js à la racine (front + /api).
# Ce fichier ne sert que si vous lancez encore l'ancienne API Nest en local.
# Local only. On Render, do NOT set PORT (Render injects it).
PORT=4000

# Allow the Vercel frontend (and any origin) to call this API
CORS_ORIGIN=*

# Neon PostgreSQL (sslmode=require is enough; channel_binding is stripped for node-pg)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/dbname?sslmode=require

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Cloudinary — photos des projets (hannon/projects) et des services (hannon/services).
# Ne pas stocker les fichiers sur le disque : l'API les envoie depuis la mémoire.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Seeded admin (created on first boot if no admin exists)
ADMIN_EMAIL=admin@hannoninterinvest.com
ADMIN_PASSWORD=HannonAdmin2026!
