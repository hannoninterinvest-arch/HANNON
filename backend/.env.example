# Local only. On Render, do NOT set PORT (Render injects it).
PORT=4000

# Allow the Vercel frontend (and any origin) to call this API
CORS_ORIGIN=*

# Neon PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST/dbname?sslmode=require

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Seeded admin (created on first boot if no admin exists)
ADMIN_EMAIL=admin@hannoninterinvest.com
ADMIN_PASSWORD=HannonAdmin2026!
